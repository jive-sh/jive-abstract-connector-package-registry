{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "jive-abstract-connector-package-registry",
  "description": "A Jive abstract for package-registry connectors: extends jive-abstract-connector with the functions every package-registry connector exposes, such as checking a package exists and registering a trusted publisher.",
  "version": "0.3.0",
  "type": "module",
  "types": "./src/index.ts",
  "peerDependencies": {
    "convex": "^1.48.0",
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jive-abstract-connector": "^0.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "convex": "^1.48.0",
    "effect": "^4.0.0",
    "jive-abstract-library": "0.2.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun install --cwd test/fixture --frozen-lockfile && bun test ./test",
    "jive:cicd:deploy:plan": "jive-library cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "dev": "jive-library dev"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": []
    }
  }
}
